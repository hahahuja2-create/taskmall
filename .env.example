NODE_ENV=production
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=https://taskmall.example
# Set a persistent, backed-up directory outside temporary deployment storage.
TASKMALL_DATA_DIR=./data
# Use one Node process and persistent local disk for SQLite.
TASKMALL_SQLITE=1
TRON_DEPOSITS_ENABLED=1
# Local Windows provisioning only. Public hosting receives the verified public configuration,
# not the private vault. Enable automatic generation on the operator's Windows machine.
TRON_AUTO_WALLET=0
TRON_TREASURY_ADDRESS=TZBZHkdrwv6xrGzRR9a1WqStf3oEmtjDvw
# Server-side credential only. Never place a private key or mnemonic here.
TRONGRID_API_KEY=
# Local automatic provisioning creates this public-only configuration.
TRON_WALLET_PUBLIC_FILE=./config/tron-wallet-public.json
TASKMALL_OPERATOR_ENABLED=1
TASKMALL_OPERATOR_TOKEN_FILE=./data/operator.token
# Admission remains closed until balance reconciliation and a real payout rehearsal.
TRON_MANUAL_WITHDRAWALS_ENABLED=0
# Collection signing runs separately on the operator Windows computer, never the public web host.
TRON_COLLECTION_SEND=0
TRON_RECOVERY_VERIFIED=0
TRON_COLLECTION_FEE_LIMIT_SUN=20000000
# Explicit daily upper bounds are required before enabling automatic gas funding.
TRON_GAS_FUNDING_ENABLED=0
TRON_GAS_DAILY_LIMIT_SUN=50000000
TRON_COLLECTION_DAILY_FEE_LIMIT_SUN=40000000
# Suggested local rehearsal caps, not fee estimates or authorization to send.
# Guided private startup verifies recovery and requires your treasury confirmation:
# npm run collections:enable
# Test funding is never enabled in this configuration.
